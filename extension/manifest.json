{
  "manifest_version": 3,
  "name": "Nikokara Player",
  "version": "0.2.0",
  "description": "Drives a bilibili tab from a local karaoke queue server: auto-advance to the next requested video.",
  "permissions": ["tabs", "alarms", "storage"],
  "host_permissions": ["http://*/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Nikokara Player"
  },
  "content_scripts": [
    {
      "matches": ["*://*.bilibili.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
