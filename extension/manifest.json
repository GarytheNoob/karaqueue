{
  "manifest_version": 3,
  "name": "KaraQueue",
  "version": "0.4.6",
  "description": "Drives a bilibili tab from a local karaoke queue server: auto-advance to the next requested video.",
  "permissions": ["tabs", "alarms", "storage"],
  "host_permissions": ["http://*/*"],
  "optional_host_permissions": [
    "http://*/*",
    "*://*.bilibili.com/*",
    "*://*.youtube.com/*",
    "*://youtu.be/*"
  ],
  "background": {
    "scripts": ["background.js"],
    "service_worker": "background.js"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "karaqueue@karaqueue.local",
      "strict_min_version": "127.0"
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "KaraQueue"
  },
  "content_scripts": [
    {
      "matches": ["*://*.bilibili.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.youtube.com/*", "*://youtu.be/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
